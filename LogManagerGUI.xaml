<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Manager Tool"
        Height="300"
        Width="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
        <Grid Margin="10">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Action -->
                        <RowDefinition Height="Auto"/>
                        <!-- Folder -->
                        <RowDefinition Height="Auto"/>
                        <!-- Keyword -->
                        <RowDefinition Height="Auto"/>
                        <!-- Start Date -->
                        <RowDefinition Height="Auto"/>
                        <!-- End Date -->
                        <RowDefinition Height="Auto"/>
                        <!-- Progress Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Action Row -->
                <TextBlock Grid.Row="0"
                           Text="Select Action:"
                           Margin="0,5,0,5"/>
                <ComboBox x:Name="actionCombo"
                          Grid.Row="0"
                          Margin="100,5,0,5"
                          Width="200">
                        <ComboBoxItem Content="Compress Logs"/>
                        <ComboBoxItem Content="View Logs"/>
                        <ComboBoxItem Content="Search Logs"/>
                </ComboBox>

                <TextBlock Grid.Row="1"
                           Text="Log Folder:"
                           Margin="0,5,0,5"/>
                <TextBox x:Name="folderPath"
                         Grid.Row="1"
                         Margin="100,5,0,5"
                         Height="25"
                         Width="200"/>
                <Button x:Name="browseButton"
                        Grid.Row="1"
                        Content="Browse..."
                        Margin="390,5,0,5"
                        Width="75"
                        Height="25"/>

                <TextBlock Grid.Row="2"
                           Text="Keyword:"
                           Margin="0,5,0,5"/>
                <TextBox x:Name="keywordBox"
                         Grid.Row="2"
                         Margin="100,5,0,5"
                         Height="25"
                         Width="200"/>

                <TextBlock Grid.Row="3"
                           Text="Start Date:"
                           Margin="0,5,0,5"/>
                <DatePicker x:Name="startDate"
                            Grid.Row="3"
                            Margin="100,5,0,5"
                            Width="200"/>

                <TextBlock Grid.Row="4"
                           Text="End Date:"
                           Margin="0,5,0,5"/>
                <DatePicker x:Name="endDate"
                            Grid.Row="4"
                            Margin="100,5,0,5"
                            Width="200"/>

                <ProgressBar x:Name="progressBar"
                             Grid.Row="5"
                             Margin="0,10,0,5"
                             Height="20"
                             Minimum="0"
                             Maximum="100"/>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,10">
                        <Button x:Name="runButton"
                                Content="Run"
                                Width="100"
                                Height="25"
                                Margin="10,0"/>
                        <Button x:Name="exportButton"
                                Content="Export Results"
                                Width="150"
                                Height="25"
                                Margin="10,0"/>
                </StackPanel>
        </Grid>
</Window>